   126 00001654 7316                <1>     jae .store  ;If a normal char print it
   127                              <1>     ;Pick off LF, CR and TAB as special chars. Everything else is a ctrl char!
   128 00001656 3C0A                <1>     cmp al, LF 
   129 00001658 7412                <1>     je .store
   130 0000165A 3C0D                <1>     cmp al, CR
