    54                              <1> ;Do 10000's
    55 000015D7 B910270000          <1>     mov ecx, 10000
    56 000015DC E827000000          <1>     call .doCompute
    57                              <1> ;Do 1000's
    58 000015E1 B9E8030000          <1>     mov ecx, 1000
    59 000015E6 E81D000000          <1>     call .doCompute
    60                              <1> ;Do 100's
    61 000015EB B964000000          <1>     mov ecx, 100
    62 000015F0 E813000000          <1>     call .doCompute
    63                              <1> ;Do 10's
    64 000015F5 B90A000000          <1>     mov ecx, 10
    65 000015FA E809000000          <1>     call .doCompute
    66                              <1> ;Do 1's, mild optimisation to avoid div move the remainder directly
    67 000015FF 89D0                <1>     mov eax, edx    ;Remainder in edx
    68 00001601 E808000000          <1>     call .printDig  ;Print the value in eax
    69                              <1> ;Exit
    70 00001606 5D                  <1>     pop rbp
    71                              <1>     return
