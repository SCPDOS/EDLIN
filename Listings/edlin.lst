   159 0000168C E80C000000          <1>     call prnAsciiz  ;Print the chars in the buffer
   160 00001691 67E308              <1>     jecxz .exit     ;If we have no more chars to print, exit!
   161 00001694 FFC3                <1>     inc ebx         ;Goto next line number
   162 00001696 FFCA                <1>     dec edx         ;One less line to print!
   163 00001698 7599                <1>     jnz .freshLine  ;If this is non-zero, keep going!
   164 0000169A FFCB                <1>     dec ebx         ;We done the last line
   165                              <1> .exit:
