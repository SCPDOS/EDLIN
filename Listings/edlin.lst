   504                              <1> parseEntry:
   505                              <1> ;Parses a single command line argument.
   506                              <1> ;. means current line
   507                              <1> ;+ means positive number offset from current line
   508                              <1> ;- means negative number offset from current line
   509                              <1> ;# means line after the last line in file ALWAYS.
   510                              <1> ; This is represented in the argument var as the 
   511                              <1> ; word 0FFFFh.
   512                              <1> ;A naked number is interpreted as a line number 
   513                              <1> ; directly.
   514                              <1> ;Maximum input value per argument: 65529
   515                              <1> ;--------------------------------------------
   516                              <1> ;Input: rsi -> String to parse
   517                              <1> ;Output: (e)bx = Value of argument
   518                              <1> ;          rsi -> First char past the end of arg
   519                              <1> ;--------------------------------------------
   520 0000096C E89F000000          <1>     call skipSpaces ;Move rsi past first non-space char and get al = First char
   521 00000971 3C2B                <1>     cmp al, "+" ;Positive offset from current line
   522 00000973 7444                <1>     je .plus
   523 00000975 3C2D                <1>     cmp al, "-" ;Negative offset from current line
   524 00000977 7454                <1>     je .minus
   525 00000979 3C2E                <1>     cmp al, "." ;Current line, advance ptr to command terminator
   526 0000097B 746E                <1>     je .dot
   527 0000097D 3C23                <1>     cmp al, "#" ;Last line (-1), advance ptr to command terminator
   528 0000097F 7478                <1>     je .pound
   529 00000981 31DB                <1>     xor ebx, ebx
   530 00000983 31C9                <1>     xor ecx, ecx
   531                              <1> .getArg:
   532 00000985 3C30                <1>     cmp al, "0"
   533 00000987 7222                <1>     jb .endOfArg
   534 00000989 3C39                <1>     cmp al, "9"
   535 0000098B 771E                <1>     ja .endOfArg
   536 0000098D 81FB99190000        <1>     cmp ebx, 0FFFFh/0Ah ;If we are gonna go above the max, fail now
   537 00000993 0F832C0D0000        <1>     jae printComErr
   538 00000999 FFC9                <1>     dec ecx ;Indicate we have a valid digit
   539 0000099B 2C30                <1>     sub al, "0"
   540 0000099D 678D1C9B            <1>     lea ebx, dword [4*ebx + ebx]    ;5*ebx
   541 000009A1 D1E3                <1>     shl ebx, 1          ;2*5*ebx = 10*ebx
   542 000009A3 0FB6C0              <1>     movzx eax, al
   543 000009A6 01C3                <1>     add ebx, eax
   544 000009A8 AC                  <1>     lodsb   ;Get the next char
   545 000009A9 EBDA                <1>     jmp short .getArg
   546                              <1> .endOfArg:
   547 000009AB 85C9                <1>     test ecx, ecx
   548                              <1>     retz    ;If no char provided, exit silently. Var already 0
