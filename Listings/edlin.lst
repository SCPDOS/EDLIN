   139                              <1> .store:
   140 0000166C AA                  <1>     stosb
   141                              <1> .goDone:
   142 0000166D 3C0A                <1>     cmp al, LF  ;If not a line feed yet, keep going
   143 0000166F 7404                <1>     je .lfFnd   ;Else, we are done!
   144 00001671 FFC9                <1>     dec ecx     ;One less char to deal with
   145 00001673 75CE                <1>     jnz .goLine
   146                              <1> .lfFnd:
   147 00001675 FFC9                <1>     dec ecx     ;Drop the final char on the line too!
