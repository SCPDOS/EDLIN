    72                              <1> .doCompute:
    73                              <1> ;Input: ecx = Divisor for place value
    74                              <1> ;       edx = Remainder left to divide
    75 00001608 89D0                <1>     mov eax, edx    ;Moves the prev. remainder into eax for dividing
    76 0000160A 31D2                <1>     xor edx, edx    
    77 0000160C F7F1                <1>     div ecx         
    78                              <1> .printDig:
    79                              <1> ;Now print the digit in al, the quotient. edx has the remainder
