   143                              <1> getFindPatrn:
   144                              <1> ;Moves the find pattern until ^Z or <CR> found. 
   145                              <1> ;Input: rsi -> Command buffer
   146                              <1> ;       rdi -> Storage buffer
   147                              <1> ; byte [keepOld] = If we copy 0 chars, do we use old search data or not?
   148                              <1> ;Output:
   149                              <1> ;       al = Terminating char
   150                              <1> ;       ecx = Number of chars copied
   151                              <1> ;       rsi -> Char past the terminating char
   152                              <1> ;       rdi -> Same in storage buffer
   153 0000070C 31C9                <1>     xor ecx, ecx
   154                              <1> .lp:
   155 0000070E AC                  <1>     lodsb           ;Get char from buffer
   156 0000070F 3C16                <1>     cmp al, CMD     ;If not a ^V, check if it is a terminating char
   157 00000711 7508                <1>     jne .noConvert
   158 00000713 AC                  <1>     lodsb   ;Get the next char to convert into a control character
   159 00000714 E8EF000000          <1>     call doControl  ;Convert it!
   160 00000719 EB04                <1>     jmp short .checkCR  ;Ignore <EOF> in this case
   161                              <1> .noConvert:
   162 0000071B 3C1A                <1>     cmp al, EOF ;Was char an <EOF>?
   163 0000071D 7409                <1>     je .end     ;End if so!
   164                              <1> .checkCR:
   165 0000071F 3C0D                <1>     cmp al, CR  ;Was char a <CR>?
   166 00000721 7405                <1>     je .end     ;End if so!
   167 00000723 AA                  <1>     stosb       ;Else store and
   168 00000724 FFC1                <1>     inc ecx     ;inc the copy counter!
   169 00000726 EBE6                <1>     jmp short .lp
   170                              <1> .end:
   171 00000728 85C9                <1>     test ecx, ecx   ;Did we copy zero chars?
   172 0000072A 7409                <1>     jz .noNew       ;If so, check if we should use previous data...
   173 0000072C 57                  <1>     push rdi
   174 0000072D 4829CF              <1>     sub rdi, rcx    ;Else get a ptr to the start of the buffer
   175 00000730 884FFF              <1>     mov byte [rdi - 1], cl  ;And place the string length w/o terminator!
   176 00000733 5F                  <1>     pop rdi
   177                              <1>     return
    13                              <2> %%_ret:
    14 00000734 C3                  <2>  ret
